class Solution {

    public int[] sortArray(int[] nums) {

        mergeSort(nums, 0, nums.length - 1);

        return nums;
    }

    private void mergeSort(int[] a, int l, int r) {

        if (l >= r) return;

        int mid = l + (r - l) / 2;

        mergeSort(a, l, mid);
        mergeSort(a, mid + 1, r);

        merge(a, l, mid, r);
    }

    private void merge(int[] a, int l, int mid, int r) {

        int[] temp = new int[r - l + 1];

        int i = l;
        int j = mid + 1;
        int k = 0;

        while (i <= mid && j <= r) {

            if (a[i] <= a[j])
                temp[k++] = a[i++];
            else
                temp[k++] = a[j++];
        }

        while (i <= mid)
            temp[k++] = a[i++];

        while (j <= r)
            temp[k++] = a[j++];

        for (int x = 0; x < temp.length; x++)
            a[l + x] = temp[x];
    }
}
