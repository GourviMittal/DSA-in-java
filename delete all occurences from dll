static DNode deleteAll(
    DNode head,
    int value
) {

    DNode current = head;

    while (current != null) {

        if (current.data == value) {

            if (current.prev != null)
                current.prev.next = current.next;
            else
                head = current.next;

            if (current.next != null)
                current.next.prev = current.prev;
        }

        current = current.next;
    }

    return head;
}
