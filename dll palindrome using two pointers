static boolean isPalindromeDLL(DNode head) {

    if (head == null)
        return true;

    DNode left = head;
    DNode right = head;

    while (right.next != null) {
        right = right.next;
    }

    while (left != right &&
           left.prev != right) {

        if (left.data != right.data)
            return false;

        left = left.next;
        right = right.prev;
    }

    return true;
}
